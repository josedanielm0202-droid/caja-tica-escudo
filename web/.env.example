# Ruta base de los archivos estáticos. Sin secretos.
# Vercel (raíz del dominio): /
# GitHub Pages (sitio del proyecto): /caja-tica-escudo/
VITE_BASE_PATH=/

# Txid interno del préstamo (64 hex). Es el mismo valor que LOAN_TXID
# de la raíz: lo escribe `npm run depositar` y está en docs/transacciones.md.
# Vacío = el panel muestra datos de ejemplo. También se puede pasar ?txid=
# No pongas llaves acá. Este archivo no lleva secretos.
VITE_TXID_DEMO=

# Colones por 1 USDC. Solo para la planilla y el retiro simulado.
# No es la tasa del mercado y no mueve dinero.
VITE_TIPO_CAMBIO_EJEMPLO=512.4
